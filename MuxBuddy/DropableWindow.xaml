<ui:FluentWindow x:Class="MuxBuddy.DropableWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MuxBuddy"
                 mc:Ignorable="d"
                 WindowBackdropType="Mica"
                 Background="Transparent"
                 WindowStyle="None"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Title="Mux Buddy"
                 AllowDrop="True"
                 Drop="MainWindow_OnDrop"
                 DragEnter="Window_DragEnter"
                 DragLeave="Window_DragLeave"
                 Height="500" MaxHeight="800" MinHeight="300"
                 Width="400" MaxWidth="400" MinWidth="300"
                 ResizeMode="NoResize">
    <ui:FluentWindow.DataContext>
        <vm:DropableWindowViewModel/>
    </ui:FluentWindow.DataContext>
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"
                         ProgressState="{Binding TaskbarProgressState}"
                         ProgressValue="{Binding TaskbarProgressValue}"/>
    </Window.TaskbarItemInfo>
    <Grid Background="Transparent">
        <Border x:Name="DropOverlay"
                Background="#AA000000"
                Opacity="1"
                Visibility="Collapsed"
                Panel.ZIndex="5">
            <TextBlock Text="Drop Video here"
                       Foreground="White"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>
        </Border>
        <Border Background="#C8000000"
                Opacity="1"
                Visibility="{Binding FFmpegWarningVisible, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="5">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon FontSize="60" Symbol="CalendarCancel24" VerticalAlignment="Center"/>
                <TextBlock Text="FFmpeg doesn't appear to be installed on your device"
                           Foreground="White"
                           FontSize="14"
                           Margin="20"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Text="please install it using any of the following"
                           Foreground="White"
                           FontSize="14"
                           Margin="0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <UniformGrid Columns="2" Rows="2" Margin="10">
                    <UniformGrid.Resources>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="2.5,0,2.5,5"/>
                        </Style>
                    </UniformGrid.Resources>
                    <ui:Button Command="{Binding WingetInstallCommand}" Content="WinGet (Best)"/>
                    <ui:Button Command="{Binding ChocoInstallCommand}" Content="Chocolatey"/>
                    <ui:Button Command="{Binding ScoopInstallCommand}" Content="Scoop"/>
                    <ui:Button Command="{Binding WebInstallCommand}" Content="FFmpeg Source"/>
                </UniformGrid>
                <Separator Margin="0,2.5"/>
                <Button HorizontalAlignment="Center" Content="Refresh" Command="{Binding RefreshFfmpegCommand}"/>
            </StackPanel>
        </Border>
        <ui:TitleBar
            Height="32"
            ShowMinimize="True"
            ShowMaximize="False"
            ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/MuxBuddyLogo_Clear.ico"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <ui:TextBlock Text="Mux Buddy" VerticalAlignment="Center" FontTypography="Caption"/>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <ui:Button 
                    Width="46"
                    Height="32"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    ToolTip="Settings"
                    CornerRadius="0"
                    Icon="{ui:SymbolIcon Settings20}"
                    Click="TrayButton_Click"/>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Grid Margin="0,32,0,0">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer x:Name="VideoViewPanel" Margin="0,0,0,0" Padding="24,0" Visibility="Visible">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Orientation="Vertical">
                        <ui:TextBlock Text="Input" Margin="0,12,0,2.5" FontTypography="Title"/>
                        <ui:Card>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding VideoPathText}"/>
                                <StackPanel Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                                    <Separator Margin="0,2.5"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Video"/>
                                            <TextBlock Text="{Binding VideoBeforeBitrateText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Audio"/>
                                            <TextBlock Text="{Binding VideoBeforeAudioBitrateText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Total"/>
                                            <TextBlock Text="{Binding VideoBeforeTotalBitrateText}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,5,0,0">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Size"/>
                                            <TextBlock Text="{Binding VideoBeforeSizeText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Streams"/>
                                            <TextBlock Text="{Binding VideoBeforeAudioCountText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Duration"/>
                                            <TextBlock Text="{Binding VideoBeforeDurationText}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,5,0,-2.5">
                                        <UniformGrid.Resources>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </Style>
                                        </UniformGrid.Resources>
                                        <ui:Button Margin="0,0,2.5,0" Command="{Binding OpenVideoCommand}" Content="Open Video"/>
                                        <ui:Button Margin="2.5,0,0,0" Command="{Binding OpenInExplorerCommand}" Content="Open in Explorer"/>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                        <StackPanel Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBlock Text="Time" Margin="0,12,0,2.5" FontTypography="Subtitle"/>
                            <ui:Card>
                                <UniformGrid Columns="2">
                                    <UniformGrid.Resources>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="2.5,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </UniformGrid.Resources>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Start"/>
                                        <ui:NumberBox Value="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Hidden" Minimum="0" Maximum="{Binding EndTime}"/>
                                        <TextBlock Text="{Binding StartTimeText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="End"/>
                                        <ui:NumberBox Value="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Hidden" Minimum="{Binding StartTime}" Maximum="{Binding EndTimeMaximum}"/>
                                        <TextBlock Text="{Binding EndTimeText}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </ui:Card>
                            <ui:TextBlock Text="Video Encoding" Margin="0,12,0,2.5" FontTypography="Subtitle"/>                            
                            <ui:Card>
                                <StackPanel Orientation="Vertical">
                                    <ui:ToggleSwitch IsChecked="{Binding IsEncodingEnabled, Mode=TwoWay}" Content="Encode"/>
                                    <StackPanel Visibility="{Binding EncodeSettingsVisible, Converter={StaticResource BoolToVisibility}}" Orientation="Vertical" Margin="0,10,0,0">
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <UniformGrid.Resources>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </UniformGrid.Resources>
                                            <ui:Button Margin="0,0,2.5,0" Command="{Binding SetBitrateBySizeCommand}" BorderThickness="1" Content="By Size"/>
                                            <ui:Button Margin="2.5,0,0,0" Command="{Binding SetBitrateByBitrateCommand}" Content="By Bitrate"/>
                                        </UniformGrid>
                                        <StackPanel Visibility="{Binding BitrateBySizeVisible, Converter={StaticResource BoolToVisibility}}">
                                            <UniformGrid Columns="4" IsEnabled="{Binding PresetSizesEnabled}">
                                                <UniformGrid.Resources>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Margin" Value="2.5,0"/>
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </UniformGrid.Resources>
                                                <ui:Button Command="{Binding SetPresetSizeCommand}" CommandParameter="10" Content="10"/>
                                                <ui:Button Command="{Binding SetPresetSizeCommand}" CommandParameter="20" Content="20"/>
                                                <ui:Button Command="{Binding SetPresetSizeCommand}" CommandParameter="30" Content="30"/>
                                                <ui:Button Command="{Binding SetPresetSizeCommand}" CommandParameter="40" Content="40"/>
                                            </UniformGrid>
                                            <Separator Margin="0,2.5"/>
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding CustomSizeEnabled, Mode=TwoWay}"/>
                                                <ui:NumberBox Value="{Binding DesiredSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CustomSizeEnabled}" SpinButtonPlacementMode="Hidden" Minimum="0"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding BitrateByBitrateVisible, Converter={StaticResource BoolToVisibility}}">
                                            <ui:NumberBox Value="{Binding CustomVideoBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Hidden" Minimum="0"/>
                                        </StackPanel>
                                        <Separator Margin="0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Video Codec"/>
                                            <ComboBox Width="150" SelectedIndex="{Binding SelectedEncoderIndex, Mode=TwoWay}" Grid.Column="1">
                                                <ComboBoxItem Content="NVENC H.264"/>
                                                <ComboBoxItem Content="NVENC H.265"/>
                                                <ComboBoxItem Content="AMF H.264"/>
                                                <ComboBoxItem Content="AMF H.265"/>
                                                <ComboBoxItem Content="QSV H.264"/>
                                                <ComboBoxItem Content="QSV H.265"/>
                                                <ComboBoxItem Content="CPU H.264"/>
                                                <ComboBoxItem Content="CPU H.265"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                            <ui:TextBlock Text="Audio Encoding" Margin="0,12,0,2.5" FontTypography="Subtitle"/>                     
                            <ui:Card>
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Audio Bitrate"/>
                                        <ComboBox Width="150" SelectedIndex="{Binding SelectedAudioBitrateIndex, Mode=TwoWay}" Grid.Column="1" DockPanel.Dock="Right">
                                            <ComboBoxItem Content="Default"/>
                                            <ComboBoxItem Content="96" IsEnabled="{Binding CanUseAudio96}"/>
                                            <ComboBoxItem Content="128" IsEnabled="{Binding CanUseAudio128}"/>
                                            <ComboBoxItem Content="192" IsEnabled="{Binding CanUseAudio192}"/>
                                            <ComboBoxItem Content="320" IsEnabled="{Binding CanUseAudio320}"/>
                                            <ComboBoxItem Content="Custom"/>
                                        </ComboBox>
                                    </Grid>
                                    <ui:NumberBox Margin="0,10,0,0" Visibility="{Binding AudioCustomBitrateVisible, Converter={StaticResource BoolToVisibility}}" Value="{Binding CustomAudioBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0"/>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Audio Mix Mode"/>
                                    <ComboBox Grid.Column="1" Width="150" SelectedIndex="{Binding SelectedAudioMixModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Don't Mix"/>
                                        <ComboBoxItem Content="Mix All" IsEnabled="{Binding CanMixAudio}"/>
                                        <ComboBoxItem Content="Mix and keep" IsEnabled="{Binding CanMixAudio}"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}" Orientation="Vertical">
                            <ui:TextBlock Text="Output" Margin="0,12,0,2.5" FontTypography="Title"/>    
                            <ui:Card Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding OutputPathText}"/>
                                    <Separator Margin="0,2.5"/>
                                    <StackPanel Orientation="Vertical" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,5">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Padding="0" Margin="0,2.5" BorderThickness="0" Height="5"/>
                                        <UniformGrid Columns="3">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="FPS"/>
                                                <TextBlock Text="{Binding StatsFpsText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="Elapsed"/>
                                                <TextBlock Text="{Binding StatsElapsedText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="Remaining"/>
                                                <TextBlock Text="{Binding StatsRemainingText}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <UniformGrid Columns="3">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Video"/>
                                            <TextBlock Text="{Binding VideoAfterBitrateText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Audio"/>
                                            <TextBlock Text="{Binding VideoAfterAudioBitrateText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Total"/>
                                            <TextBlock Text="{Binding VideoAfterTotalBitrateText}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="3" Margin="0,5,0,0">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Size"/>
                                            <TextBlock Text="{Binding VideoAfterSizeText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Streams"/>
                                            <TextBlock Text="{Binding VideoAfterAudioCountText}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Duration"/>
                                            <TextBlock Text="{Binding VideoAfterDurationText}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Background="{ui:ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <UniformGrid VerticalAlignment="Bottom" Margin="24" Columns="2">
                        <UniformGrid.Resources>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Margin" Value="2.5,0"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </UniformGrid.Resources>
                        <ui:Button Background="{ui:ThemeResource AccentTextFillColorTertiaryBrush}" IsEnabled="{Binding IsMainEnabled}" Command="{Binding EncodeCommand}" Content="Encode"/>
                        <ui:Button IsEnabled="{Binding HasVideo}" Command="{Binding ClearFilesCommand}" Content="Clear"/>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
